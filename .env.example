# ─── Настройки NexusCRM ────────────────────────────────────────────────
# Скопируйте этот файл в .env и отредактируйте. Файл .env не коммитится в git.
# Все параметры необязательны — без .env приложение работает со значениями по умолчанию.

# Порт и адрес, на котором слушает сервер
PORT=3001
HOST=0.0.0.0

# Путь к файлу базы данных (по умолчанию ./crm.db в рабочей директории)
# CRM_DB_PATH=/var/lib/nexuscrm/crm.db

# Пароль учётной записи admin при ПЕРВОМ запуске на чистой базе
# (после создания пользователя переменная ни на что не влияет)
# ADMIN_PASSWORD=change-me-now

# ─── Cookies сессии ────────────────────────────────────────────────────
# sameSite: lax (по умолчанию, рекомендуется для production) | strict | none
# none нужен только если приложение показывается внутри iframe на чужом домене
COOKIE_SAMESITE=lax
# Secure-флаг: 1 = только HTTPS, 0 = разрешить по HTTP, не задано = автоматически
# (по умолчанию ставится, когда запрос пришёл по HTTPS)
# COOKIE_SECURE=

# Срок жизни сессии в днях (1–90, по умолчанию 7)
SESSION_DAYS=7

# ─── Работа за reverse-proxy (nginx) ───────────────────────────────────
# Включите, если перед приложением стоит nginx/другой прокси — корректные IP клиентов
# TRUST_PROXY=1

# Список внешних origin, которым разрешён CORS с cookies (через запятую).
# Обычно НЕ нужен: интерфейс и API обслуживаются одним сервером.
# CORS_ORIGINS=https://crm.example.com

# Разрешить встраивание приложения во внешний iframe (0/1). По умолчанию запрещено.
# ALLOW_EMBED=0

# Однократно импортировать приложенный «Экспорт_колледж - 20261029-184934.xlsx»
# при старте. По умолчанию включено; существующие аккаунты и БД не заменяются.
# Для отключения ДО обновления/первого запуска: IMPORT_BUNDLED_COLLEGE=0

# Однократно импортировать приложенный «Отчет ДОД - 29.10.2026 19-20-30.xlsx».
# Для отключения ДО запуска: IMPORT_BUNDLED_DOD=0
